#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <200>; };

&mt {
    quick_tap_ms = <200>;
    tapping-term-ms = <200>;
    require-prior-idle-ms = <125>;
    flavor = "tap-preferred";
};

/ {
    behaviors {
        hmr_sk: hmr_sk {
            compatible = "zmk,behavior-sticky-key";
            label = "HMR_SK";
            bindings = <&kp>;
            #binding-cells = <1>;
            ignore-modifiers;
            release-after-ms = <2000>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&none               &mt LALT ESC        &kp Q               &kp W               &kp E               &kp R               &kp T               &kp Y               &kp U               &kp I               &kp O               &kp P               &kp BACKSPACE       &none
                    &mt LCTRL CAPS      &kp A               &kp S               &kp D               &kp F               &kp G               &kp H               &kp J               &kp K               &kp L               &kp SQT             &kp LEFT_BRACKET
                    &kp LGUI            &kp Z               &kp X               &kp C               &kp V               &kp B               &kp N               &kp M               &kp COMMA           &kp DOT             &kp SEMICOLON       &mt RCTRL TAB
                                                            &none               &mo 2               &mt LCTRL SPACE     &mt LGUI RET        &mt RALT GRAVE      &kp RIGHT_SHIFT     &mo 1               &none
            >;
        };

        symbol_layer {
            display-name = "Symbol";
            bindings = <
&none               &trans              &kp LESS_THAN       &kp LEFT_BRACKET    &kp LEFT_BRACE      &kp LEFT_PARENTHESIS  &kp TILDE           &kp CARET           &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE     &kp RIGHT_BRACKET   &kp GREATER_THAN    &trans              &none
                    &trans              &kp MINUS           &kp ASTERISK        &kp EQUAL           &kp UNDER           &kp DLLR            &kp HASH            &hmr_sk RIGHT_SHIFT  &hmr_sk RCTRL       &hmr_sk RIGHT_ALT   &hmr_sk RIGHT_GUI   &kp DQT
                    &trans              &kp PLUS            &kp PIPE            &kp AT              &kp SLASH           &kp PRCNT           &kp COLON           &kp BACKSLASH       &kp AMPS            &kp QMARK           &kp EXCL            &trans
                                                            &none               &mo 3               &trans              &trans              &trans              &trans              &trans              &none
            >;
        };

        extend_layer {
            display-name = "Extend";
            bindings = <
&none               &trans              &kp C_MUTE          &kp C_PLAY_PAUSE    &kp C_VOL_DN        &kp C_VOL_UP        &kp C_BRI_UP        &kp HOME            &kp PAGE_DOWN       &kp PG_UP           &kp END             &none               &trans              &none
                    &trans              &hmr_sk LEFT_GUI    &hmr_sk LEFT_ALT    &hmr_sk LEFT_CONTROL  &hmr_sk LEFT_SHIFT  &kp C_BRI_DN        &kp LEFT_ARROW      &kp DOWN_ARROW      &kp UP_ARROW        &kp RIGHT_ARROW     &kp BACKSPACE       &trans
                    &trans              &kp ESCAPE          &kp C_PREV          &kp C_NEXT          &kp TAB             &key_repeat         &key_repeat         &none               &none               &none               &kp DELETE          &trans
                                                            &none               &trans              &trans              &trans              &trans              &trans              &mo 3               &none
            >;
        };

        number_layer {
            display-name = "Number";
            bindings = <
&none               &trans              &kp N7              &kp N5              &kp N3              &kp N1              &kp N9              &kp N8              &kp N0              &kp N2              &kp N4              &kp N6              &trans              &none
                    &trans              &hmr_sk LGUI        &hmr_sk LALT        &hmr_sk LCTRL       &hmr_sk LSHFT       &kp F11             &kp F12             &kp DOT             &kp COMMA           &kp MINUS           &kp COLON           &trans
                    &trans              &kp F7              &kp F5              &kp F3              &kp F1              &kp F9              &kp F8              &kp F10             &kp F2              &kp F4              &kp F6              &trans
                                                            &none               &trans              &trans              &mo 4               &trans              &trans              &trans              &none
            >;
        };

        control_layer {
            display-name = "Control";
            bindings = <
&none               &none               &bt BT_CLR          &none               &none               &none               &bootloader         &bootloader         &none               &none               &none               &bt BT_CLR          &none               &none
                    &none               &bt BT_SEL 0        &bt BT_SEL 1        &bt BT_SEL 2        &bt BT_SEL 3        &bt BT_SEL 4        &bt BT_SEL 4        &bt BT_SEL 3        &bt BT_SEL 2        &bt BT_SEL 1        &bt BT_SEL 0        &none
                    &none               &studio_unlock      &none               &none               &none               &sys_reset          &sys_reset          &none               &none               &none               &studio_unlock      &none
                                                            &none               &none               &none               &none               &none               &none               &none               &none
            >;
        };
    };
};
